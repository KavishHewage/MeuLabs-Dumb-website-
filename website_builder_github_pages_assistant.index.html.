                c.classList.remove('border-indigo-500', 'bg-slate-800/80');
                c.classList.add('border-slate-800', 'bg-slate-900');
            });
            const activeCard = document.getElementById(`tmpl-${tmpl}`);
            if (activeCard) {
                activeCard.classList.remove('border-slate-800', 'bg-slate-900');
                activeCard.classList.add('border-indigo-500', 'bg-slate-800/80');
            }
            renderApp();
        }

        function setAccentColor(color) {
            state.accentColor = color;
            Object.keys(colorHexMap).forEach(c => {
                const check = document.querySelector(`.check-${c}`);
                if (check) check.classList.add('hidden');
            });
            const currentCheck = document.querySelector(`.check-${color}`);
            if (currentCheck) currentCheck.classList.remove('hidden');
            renderApp();
        }

        function setThemeMode(mode) {
            state.themeMode = mode;
            const darkBtn = document.getElementById('theme-dark-btn');
            const lightBtn = document.getElementById('theme-light-btn');

            if (mode === 'dark') {
                darkBtn.className = "p-3 rounded-xl border-2 border-indigo-500 bg-slate-800 text-slate-100 flex items-center justify-center space-x-2 text-xs font-medium";
