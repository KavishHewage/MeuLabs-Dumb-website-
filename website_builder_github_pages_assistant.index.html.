        function addSkill() {
            const input = document.getElementById('new-skill-input');
            const val = input.value.trim();
            if (val && !state.skills.includes(val)) {
                state.skills.push(val);
                input.value = '';
                renderSkillsUI();
                renderApp();
            }
        }

        function removeSkill(index) {
            state.skills.splice(index, 1);
            renderSkillsUI();
            renderApp();
        }

        function renderSkillsUI() {
            const container = document.getElementById('skills-list');
            container.innerHTML = state.skills.map((skill, idx) => `
                <span class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-800 text-slate-200 border border-slate-700">
                    <span>${escapeHtml(skill)}</span>
                    <button onclick="removeSkill(${idx})" class="text-slate-400 hover:text-rose-400 transition ml-1">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </span>
            `).join('');
        }

        // Projects logic
        function addProject() {
            const newProj = {
                id: Date.now(),
                title: 'New Dynamic Project',
                desc: 'Descriptive narrative of modern features, key architectural components, and solutions.',
                tags: 'JavaScript, HTML, CSS',
                liveUrl: 'https://example.com',
                githubUrl: 'https://github.com',
