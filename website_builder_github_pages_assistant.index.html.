<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GitStack - Website Builder & GitHub Pages Deployment Assistant</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: 'Inter', sans-serif; }
        .font-mono { font-family: 'Fira Code', monospace; }
        
        /* Custom Scrollbar for editor panels */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }

        /* Device Frame Transitions */
        .preview-container {
            transition: all 0.3s ease-in-out;
        }
        .device-desktop { width: 100%; height: 100%; border-radius: 0px; }
        .device-tablet { width: 768px; height: 90%; border-radius: 16px; border: 8px solid #334155; }
        .device-mobile { width: 375px; height: 85%; border-radius: 24px; border: 8px solid #334155; }

        /* Toast Animation */
        @keyframes slideUp {
            from { transform: translateY(100%); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        .toast-animate {
            animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</head>
<body class="h-full flex flex-col overflow-hidden bg-slate-950 text-slate-100 selection:bg-indigo-500 selection:text-white">

    <!-- Navigation Header -->
    <header class="h-16 bg-slate-900/80 border-b border-slate-800 backdrop-blur-md px-4 flex items-center justify-between shrink-0 z-30">
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 via-violet-600 to-pink-500 flex items-center justify-center shadow-lg shadow-indigo-500/20">
                <i class="fa-solid fa-cubes text-white text-lg"></i>
            </div>
            <div>
                <div class="flex items-center space-x-2">
                    <h1 class="font-bold text-slate-100 text-lg leading-none">GitStack</h1>
                    <span class="px-2 py-0.5 text-[10px] font-semibold bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 rounded-full">v2.4</span>
                </div>
                <p class="text-xs text-slate-400">Site Builder & GitHub Pages Deployer</p>
            </div>
        </div>

        <!-- Central View Controls -->
        <div class="hidden md:flex items-center bg-slate-950 p-1 rounded-xl border border-slate-800">
            <button id="viewPreviewBtn" onclick="switchMainView('preview')" class="px-4 py-1.5 rounded-lg text-xs font-medium transition-all flex items-center space-x-2 bg-indigo-600 text-white shadow-md">
                <i class="fa-solid fa-eye"></i>
                <span>Live Preview</span>
            </button>
            <button id="viewCodeBtn" onclick="switchMainView('code')" class="px-4 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-slate-200 transition-all flex items-center space-x-2">
                <i class="fa-solid fa-code"></i>
                <span>Export Code</span>
            </button>
            <button id="viewGuideBtn" onclick="switchMainView('guide')" class="px-4 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-slate-200 transition-all flex items-center space-x-2">
                <i class="fa-brands fa-github"></i>
                <span>Deployment Guide</span>
            </button>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center space-x-2">
            <button onclick="copyGeneratedCode()" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 rounded-lg text-xs font-medium flex items-center space-x-1.5 transition">
                <i class="fa-regular fa-copy text-indigo-400"></i>
                <span class="hidden sm:inline">Copy HTML</span>
            </button>
            <button onclick="downloadCodeFile()" class="px-3 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-semibold flex items-center space-x-1.5 shadow-lg shadow-indigo-600/30 transition">
                <i class="fa-solid fa-download"></i>
                <span>Download index.html</span>
            </button>
        </div>
    </header>

    <!-- Main App Workspace -->
    <div class="flex-1 flex overflow-hidden">
        
        <!-- Sidebar Controls / Customizer -->
        <aside class="w-full md:w-[420px] bg-slate-900 border-r border-slate-800 flex flex-col shrink-0 z-20 overflow-hidden">
            
            <!-- Sidebar Tab Navigation -->
            <div class="flex border-b border-slate-800 bg-slate-950/50 p-1.5 overflow-x-auto space-x-1 shrink-0 no-scrollbar">
                <button onclick="switchTab('template')" id="tab-btn-template" class="tab-btn active px-3 py-2 rounded-lg text-xs font-medium text-slate-300 hover:text-white flex items-center space-x-2 shrink-0 transition bg-slate-800 text-white">
                    <i class="fa-solid fa-palette text-indigo-400"></i>
                    <span>Template</span>
                </button>
                <button onclick="switchTab('profile')" id="tab-btn-profile" class="tab-btn px-3 py-2 rounded-lg text-xs font-medium text-slate-400 hover:text-white flex items-center space-x-2 shrink-0 transition">
                    <i class="fa-solid fa-user text-indigo-400"></i>
                    <span>Profile</span>
                </button>
                <button onclick="switchTab('skills')" id="tab-btn-skills" class="tab-btn px-3 py-2 rounded-lg text-xs font-medium text-slate-400 hover:text-white flex items-center space-x-2 shrink-0 transition">
                    <i class="fa-solid fa-wand-magic-sparkles text-indigo-400"></i>
                    <span>Skills</span>
                </button>
                <button onclick="switchTab('projects')" id="tab-btn-projects" class="tab-btn px-3 py-2 rounded-lg text-xs font-medium text-slate-400 hover:text-white flex items-center space-x-2 shrink-0 transition">
                    <i class="fa-solid fa-diagram-project text-indigo-400"></i>
                    <span>Projects</span>
                </button>
                <button onclick="switchTab('experience')" id="tab-btn-experience" class="tab-btn px-3 py-2 rounded-lg text-xs font-medium text-slate-400 hover:text-white flex items-center space-x-2 shrink-0 transition">
                    <i class="fa-solid fa-briefcase text-indigo-400"></i>
                    <span>Timeline</span>
                </button>
                <button onclick="switchTab('socials')" id="tab-btn-socials" class="tab-btn px-3 py-2 rounded-lg text-xs font-medium text-slate-400 hover:text-white flex items-center space-x-2 shrink-0 transition">
                    <i class="fa-solid fa-share-nodes text-indigo-400"></i>
                    <span>Socials</span>
                </button>
            </div>

            <!-- Tab Contents Scroll Area -->
            <div class="flex-1 overflow-y-auto p-4 space-y-6">
                
                <!-- TAB 1: Template & Theme Controls -->
                <div id="tab-template" class="tab-content space-y-6">
                    <div>
                        <label class="text-xs font-semibold uppercase tracking-wider text-slate-400 block mb-3">Choose Layout Template</label>
                        <div class="grid grid-cols-2 gap-3">
                            <button onclick="setTemplate('portfolio')" id="tmpl-portfolio" class="template-card p-3 rounded-xl border-2 border-indigo-500 bg-slate-800/80 text-left hover:border-indigo-400 transition relative">
                                <div class="w-full h-16 bg-slate-900 rounded-lg mb-2 flex items-center justify-center border border-slate-700/50 overflow-hidden">
                                    <div class="w-full px-2 text-[8px] text-slate-400 space-y-1">
                                        <div class="h-2 w-12 bg-indigo-500 rounded"></div>
                                        <div class="h-1.5 w-20 bg-slate-700 rounded"></div>
                                        <div class="grid grid-cols-2 gap-1 pt-1">
                                            <div class="h-4 bg-slate-800 border border-slate-700 rounded"></div>
                                            <div class="h-4 bg-slate-800 border border-slate-700 rounded"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="text-xs font-bold text-slate-200">Modern Portfolio</div>
                                <div class="text-[10px] text-slate-400">Developer & Designer hero showcase</div>
                            </button>

                            <button onclick="setTemplate('resume')" id="tmpl-resume" class="template-card p-3 rounded-xl border-2 border-slate-800 bg-slate-900 text-left hover:border-slate-700 transition relative">
                                <div class="w-full h-16 bg-slate-950 rounded-lg mb-2 flex items-center justify-center border border-slate-800 overflow-hidden p-2">
                                    <div class="w-full text-[8px] space-y-1">
                                        <div class="h-2 w-16 bg-slate-300 rounded"></div>
                                        <div class="h-1 w-24 bg-slate-600 rounded"></div>
                                        <div class="h-px bg-slate-800 my-1"></div>
                                        <div class="h-1 w-20 bg-slate-500 rounded"></div>
                                    </div>
                                </div>
                                <div class="text-xs font-bold text-slate-200">Minimal Resume/CV</div>
                                <div class="text-[10px] text-slate-400">Structured professional curriculum</div>
                            </button>

                            <button onclick="setTemplate('product')" id="tmpl-product" class="template-card p-3 rounded-xl border-2 border-slate-800 bg-slate-900 text-left hover:border-slate-700 transition relative">
                                <div class="w-full h-16 bg-slate-950 rounded-lg mb-2 flex items-center justify-center border border-slate-800 overflow-hidden p-2">
                                    <div class="w-full text-[8px] space-y-1 text-center flex flex-col items-center">
                                        <div class="h-2 w-10 bg-emerald-500 rounded"></div>
                                        <div class="h-1.5 w-16 bg-slate-600 rounded"></div>
                                        <div class="h-3 w-12 bg-emerald-600 rounded-full mt-1"></div>
                                    </div>
                                </div>
                                <div class="text-xs font-bold text-slate-200">Product Landing</div>
                                <div class="text-[10px] text-slate-400">SaaS / App product landing page</div>
                            </button>

                            <button onclick="setTemplate('tech')" id="tmpl-tech" class="template-card p-3 rounded-xl border-2 border-slate-800 bg-slate-900 text-left hover:border-slate-700 transition relative">
                                <div class="w-full h-16 bg-slate-950 rounded-lg mb-2 flex items-center justify-center border border-slate-800 overflow-hidden p-2 font-mono">
                                    <div class="w-full text-[7px] text-cyan-400 space-y-1">
                                        <div>$ dev --init</div>
                                        <div class="text-slate-500">&gt; loading stack...</div>
                                        <div class="h-2 w-full bg-cyan-950 border border-cyan-800 rounded"></div>
                                    </div>
                                </div>
                                <div class="text-xs font-bold text-slate-200">Tech Terminal</div>
                                <div class="text-[10px] text-slate-400">Developer terminal style aesthetic</div>
                            </button>
                        </div>
                    </div>

                    <!-- Accent Color Picker -->
                    <div>
                        <label class="text-xs font-semibold uppercase tracking-wider text-slate-400 block mb-3">Accent Theme Color</label>
                        <div class="grid grid-cols-6 gap-2">
                            <button onclick="setAccentColor('indigo')" class="h-8 rounded-lg bg-indigo-600 hover:ring-2 ring-indigo-400 transition border border-indigo-400/30 flex items-center justify-center text-white text-xs"><i class="fa-solid fa-check check-indigo"></i></button>
                            <button onclick="setAccentColor('emerald')" class="h-8 rounded-lg bg-emerald-600 hover:ring-2 ring-emerald-400 transition border border-emerald-400/30 flex items-center justify-center text-white text-xs"><i class="fa-solid fa-check check-emerald hidden"></i></button>
                            <button onclick="setAccentColor('violet')" class="h-8 rounded-lg bg-violet-600 hover:ring-2 ring-violet-400 transition border border-violet-400/30 flex items-center justify-center text-white text-xs"><i class="fa-solid fa-check check-violet hidden"></i></button>
                            <button onclick="setAccentColor('cyan')" class="h-8 rounded-lg bg-cyan-600 hover:ring-2 ring-cyan-400 transition border border-cyan-400/30 flex items-center justify-center text-white text-xs"><i class="fa-solid fa-check check-cyan hidden"></i></button>
                            <button onclick="setAccentColor('rose')" class="h-8 rounded-lg bg-rose-600 hover:ring-2 ring-rose-400 transition border border-rose-400/30 flex items-center justify-center text-white text-xs"><i class="fa-solid fa-check check-rose hidden"></i></button>
                            <button onclick="setAccentColor('amber')" class="h-8 rounded-lg bg-amber-600 hover:ring-2 ring-amber-400 transition border border-amber-400/30 flex items-center justify-center text-white text-xs"><i class="fa-solid fa-check check-amber hidden"></i></button>
                        </div>
                    </div>

                    <!-- Theme Mode -->
                    <div>
                        <label class="text-xs font-semibold uppercase tracking-wider text-slate-400 block mb-3">Base Color Theme</label>
                        <div class="grid grid-cols-2 gap-3">
                            <button onclick="setThemeMode('dark')" id="theme-dark-btn" class="p-3 rounded-xl border-2 border-indigo-500 bg-slate-800 text-slate-100 flex items-center justify-center space-x-2 text-xs font-medium">
                                <i class="fa-solid fa-moon text-indigo-400"></i>
                                <span>Dark Mode</span>
                            </button>
                            <button onclick="setThemeMode('light')" id="theme-light-btn" class="p-3 rounded-xl border border-slate-800 bg-slate-900 text-slate-400 flex items-center justify-center space-x-2 text-xs font-medium hover:border-slate-700">
                                <i class="fa-solid fa-sun text-amber-400"></i>
                                <span>Light Mode</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- TAB 2: Profile & Bio -->
                <div id="tab-profile" class="tab-content hidden space-y-4">
                    <div>
                        <label class="text-xs font-medium text-slate-300 block mb-1">Full Name / Display Title</label>
                        <input type="text" id="input-name" value="Alex Rivera" oninput="updateState('profile', 'name', this.value)" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 focus:outline-none focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="text-xs font-medium text-slate-300 block mb-1">Professional Title / Subtitle</label>
                        <input type="text" id="input-title" value="Full-Stack Developer & UI Architect" oninput="updateState('profile', 'title', this.value)" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 focus:outline-none focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="text-xs font-medium text-slate-300 block mb-1">Bio / Overview</label>
                        <textarea id="input-bio" rows="3" oninput="updateState('profile', 'bio', this.value)" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 focus:outline-none focus:border-indigo-500">Passionate about building performant web applications, elegant developer tools, and accessible user experiences with modern web technologies.</textarea>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="text-xs font-medium text-slate-300 block mb-1">Location</label>
                            <input type="text" id="input-location" value="San Francisco, CA" oninput="updateState('profile', 'location', this.value)" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 focus:outline-none focus:border-indigo-500">
                        </div>
                        <div>
                            <label class="text-xs font-medium text-slate-300 block mb-1">Contact Email</label>
                            <input type="email" id="input-email" value="alex@example.com" oninput="updateState('profile', 'email', this.value)" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 focus:outline-none focus:border-indigo-500">
                        </div>
                    </div>
                    <div>
                        <label class="text-xs font-medium text-slate-300 block mb-1">Avatar / Image URL</label>
                        <input type="text" id="input-avatar" value="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300&auto=format&fit=crop&q=80" oninput="updateState('profile', 'avatar', this.value)" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 focus:outline-none focus:border-indigo-500">
                    </div>
                </div>

                <!-- TAB 3: Skills Management -->
                <div id="tab-skills" class="tab-content hidden space-y-4">
                    <div>
                        <label class="text-xs font-medium text-slate-300 block mb-1">Add Skill Tag</label>
                        <div class="flex space-x-2">
                            <input type="text" id="new-skill-input" placeholder="e.g., TypeScript, Node.js" class="flex-1 bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 focus:outline-none focus:border-indigo-500">
                            <button onclick="addSkill()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-medium">Add</button>
                        </div>
                    </div>

                    <div>
                        <label class="text-xs font-semibold uppercase tracking-wider text-slate-400 block mb-2">Active Skills</label>
                        <div id="skills-list" class="flex flex-wrap gap-2">
                            <!-- Skill tags rendered dynamically -->
                        </div>
                    </div>
                </div>

                <!-- TAB 4: Dynamic Projects -->
                <div id="tab-projects" class="tab-content hidden space-y-4">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Featured Projects</span>
                        <button onclick="addProject()" class="text-xs text-indigo-400 hover:text-indigo-300 font-medium flex items-center space-x-1">
                            <i class="fa-solid fa-plus"></i>
                            <span>Add Project</span>
                        </button>
                    </div>

                    <div id="projects-container" class="space-y-4">
                        <!-- Project Cards Dynamic Render -->
                    </div>
                </div>

                <!-- TAB 5: Experience Timeline -->
                <div id="tab-experience" class="tab-content hidden space-y-4">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Career History</span>
                        <button onclick="addExperience()" class="text-xs text-indigo-400 hover:text-indigo-300 font-medium flex items-center space-x-1">
                            <i class="fa-solid fa-plus"></i>
                            <span>Add Item</span>
                        </button>
                    </div>

                    <div id="experience-container" class="space-y-4">
                        <!-- Experience Items Dynamic Render -->
                    </div>
                </div>

                <!-- TAB 6: Social Links -->
                <div id="tab-socials" class="tab-content hidden space-y-4">
                    <div>
                        <label class="text-xs font-medium text-slate-300 block mb-1"><i class="fa-brands fa-github text-slate-400 mr-1.5"></i> GitHub Username</label>
                        <input type="text" id="social-github" value="alexrivera" oninput="updateState('socials', 'github', this.value)" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 focus:outline-none focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="text-xs font-medium text-slate-300 block mb-1"><i class="fa-brands fa-linkedin text-blue-400 mr-1.5"></i> LinkedIn Profile URL</label>
                        <input type="text" id="social-linkedin" value="https://linkedin.com/in/alexrivera" oninput="updateState('socials', 'linkedin', this.value)" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 focus:outline-none focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="text-xs font-medium text-slate-300 block mb-1"><i class="fa-brands fa-x-twitter text-slate-400 mr-1.5"></i> Twitter/X Handle</label>
                        <input type="text" id="social-twitter" value="@alexrivera_dev" oninput="updateState('socials', 'twitter', this.value)" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 focus:outline-none focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="text-xs font-medium text-slate-300 block mb-1"><i class="fa-solid fa-globe text-emerald-400 mr-1.5"></i> Personal Website / Blog</label>
                        <input type="text" id="social-website" value="https://alexrivera.dev" oninput="updateState('socials', 'website', this.value)" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 focus:outline-none focus:border-indigo-500">
                    </div>
                </div>

            </div>

            <!-- Footer Branding in Sidebar -->
            <div class="p-3 bg-slate-950 border-t border-slate-800 flex items-center justify-between text-[11px] text-slate-500">
                <span>Instant Live Sync Enabled</span>
                <span class="flex items-center space-x-1.5"><span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span><span>Ready</span></span>
            </div>
        </aside>

        <!-- Right Main Viewport Area -->
        <main class="flex-1 bg-slate-950 flex flex-col min-w-0 relative overflow-hidden">
            
            <!-- Viewport Bar (For Preview Mode) -->
            <div id="previewToolbar" class="h-10 bg-slate-900/60 border-b border-slate-800/80 px-4 flex items-center justify-between text-xs text-slate-400 shrink-0">
                <div class="flex items-center space-x-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
                    <span class="ml-2 font-mono text-[11px] text-slate-500 hidden sm:inline">index.html - Live Viewport</span>
                </div>

                <!-- Device Viewport Switcher -->
                <div class="flex items-center space-x-1 bg-slate-950 rounded-lg p-1 border border-slate-800">
                    <button onclick="setDeviceViewport('desktop')" id="device-desktop-btn" title="Desktop View" class="p-1 px-2 rounded text-indigo-400 bg-slate-800 hover:text-white transition">
                        <i class="fa-solid fa-desktop"></i>
                    </button>
                    <button onclick="setDeviceViewport('tablet')" id="device-tablet-btn" title="Tablet View" class="p-1 px-2 rounded text-slate-400 hover:text-white transition">
                        <i class="fa-solid fa-tablet-screen-button"></i>
                    </button>
                    <button onclick="setDeviceViewport('mobile')" id="device-mobile-btn" title="Mobile View" class="p-1 px-2 rounded text-slate-400 hover:text-white transition">
                        <i class="fa-solid fa-mobile-screen-button"></i>
                    </button>
                </div>
            </div>

            <!-- VIEW 1: Live Interactive Iframe Preview -->
            <div id="mainViewPreview" class="flex-1 bg-slate-950 flex items-center justify-center p-0 md:p-4 overflow-auto">
                <div id="previewWrapper" class="preview-container device-desktop bg-white overflow-hidden shadow-2xl relative">
                    <iframe id="sitePreviewIframe" class="w-full h-full border-0" title="Live Preview"></iframe>
                </div>
            </div>

            <!-- VIEW 2: Raw Code Viewer -->
            <div id="mainViewCode" class="flex-1 bg-slate-950 hidden flex-col overflow-hidden">
                <div class="p-3 bg-slate-900 border-b border-slate-800 flex items-center justify-between">
                    <span class="text-xs font-mono text-slate-400 flex items-center">
