        function setDeviceViewport(device) {
            const wrapper = document.getElementById('previewWrapper');
            wrapper.className = `preview-container device-${device} bg-white overflow-hidden shadow-2xl relative`;
            
            ['desktop', 'tablet', 'mobile'].forEach(d => {
                const btn = document.getElementById(`device-${d}-btn`);
                if (d === device) {
                    btn.className = "p-1 px-2 rounded text-indigo-400 bg-slate-800 hover:text-white transition";
                } else {
                    btn.className = "p-1 px-2 rounded text-slate-400 hover:text-white transition";
                }
            });
        }

