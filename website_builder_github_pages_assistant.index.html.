            } else {
                lightBtn.className = "p-3 rounded-xl border-2 border-indigo-500 bg-slate-800 text-slate-100 flex items-center justify-center space-x-2 text-xs font-medium";
                darkBtn.className = "p-3 rounded-xl border border-slate-800 bg-slate-900 text-slate-400 flex items-center justify-center space-x-2 text-xs font-medium hover:border-slate-700";
            }
            renderApp();
        }

